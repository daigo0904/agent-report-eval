<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.openclaw.eval-loop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/daigo/評価層/実行.py</string>
    <string>--件</string>
    <string>2</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd の既定の PATH には /opt/homebrew/bin が入らない。
         判定は node を呼ぶので、これが無いと毎回「判定を呼べない」で終わる。
         qwc-guard が毎朝 exit 127 だったのと同じ罠（2026-08-31）。 -->
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <!-- 15分おき。1回で最大6件作って判定する（1件およそ100秒）。
       ollama は待ち行列が1本なので、qwc と voice-ai が動いていたら実行.py 側で譲る。 -->
  <key>StartInterval</key>
  <integer>900</integer>
  <key>StandardOutPath</key>
  <string>/Users/daigo/.openclaw/logs/eval-loop.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/daigo/.openclaw/logs/eval-loop.err</string>
  <key>WorkingDirectory</key>
  <string>/Users/daigo/評価層</string>
</dict>
</plist>
